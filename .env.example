# --- Database (Supabase: use the TRANSACTION POOLER string, port 6543, never the direct 5432) ---
DATABASE_URI=postgres://USER:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Local dev alternative (Homebrew postgresql@17): postgres://<os-user>@localhost:5432/mbr_dev

# --- Payload ---
PAYLOAD_SECRET=change-me-64-hex-chars

# --- Cloudflare R2 (leave R2_ACCOUNT_ID empty to fall back to local ./media storage in dev) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mbr-media
R2_PUBLIC_URL=https://media.milanobeatradio.it

# --- Email (phase 4) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# --- Radio (AzuraCast, external, read-only) ---
NEXT_PUBLIC_AZURACAST_BASE=https://canali.pesstream.eu
NEXT_PUBLIC_AZURACAST_STATION=mbr

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://milanobeatradio.it
